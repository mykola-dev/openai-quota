{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["*.ts", "src/**/*.ts", "src/**/*.tsx", "test/**/*.ts"]
}
